# Copy to .env.local and adjust. Also set these in the Vercel project settings.

# Backend API origin (server-only; never prefix with NEXT_PUBLIC_).
API_BASE_URL=https://rentnest-sooty.vercel.app

# Payment gateway the pay button may redirect to (public, build-time). "sandbox" (default) allows only
# sandbox.sslcommerz.com; set "live" ONLY for a production build whose backend uses live SSLCommerz credentials.
NEXT_PUBLIC_SSLCOMMERZ_MODE=sandbox
